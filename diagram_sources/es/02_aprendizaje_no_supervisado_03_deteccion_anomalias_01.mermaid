flowchart LR
    A["Datos normales<br/>(inliers)"] --> B["Modelado de densidad<br/>o proyección (PCA)"]
    B --> C["Umbral<br/>establecido"]
    D["Nueva<br/>observación"] --> C
    C -->|"Alta densidad /<br/>bajo error"| E["Normal"]
    C -->|"Baja densidad /<br/>alto error"| F["Alerta:<br/>anomalía (outlier)"]

    classDef low fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a
    classDef high fill:#fed7aa,stroke:#f97316,color:#7c2d12
    classDef ok fill:#dcfce7,stroke:#22c55e,color:#14532d
    classDef effect fill:#fecaca,stroke:#ef4444,color:#7f1d1d

    class A,B,C low
    class D high
    class E ok
    class F effect
