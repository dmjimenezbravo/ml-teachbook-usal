flowchart TD
    D[("Original dataset<br/>N samples")] --> B1["Bootstrap sample 1<br/>(with replacement)"]
    D --> B2["Bootstrap sample 2<br/>(with replacement)"]
    D --> B3["Bootstrap sample 3<br/>(with replacement)"]
    D --> B4["..."]
    B1 --> T1["Tree 1<br/>(random subset<br/>of features)"]
    B2 --> T2["Tree 2<br/>(random subset<br/>of features)"]
    B3 --> T3["Tree 3<br/>(random subset<br/>of features)"]
    B4 --> T4["Tree N"]
    T1 --> V["Majority vote /<br/>average prediction"]
    T2 --> V
    T3 --> V
    T4 --> V
    V --> P["Final prediction"]

    classDef data fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a
    classDef bootstrap fill:#e5e7eb,stroke:#6b7280,color:#374151
    classDef tree fill:#fed7aa,stroke:#f97316,color:#7c2d12
    classDef agg fill:#e9d5ff,stroke:#a855f7,color:#581c87
    classDef final fill:#bbf7d0,stroke:#22c55e,color:#14532d

    class D data
    class B1,B2,B3,B4 bootstrap
    class T1,T2,T3,T4 tree
    class V agg
    class P final
